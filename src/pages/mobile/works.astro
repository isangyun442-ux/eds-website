---
import { projects } from '../../data/projects.js';
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <title>ALL PORTFOLIO — EDS 이담에스티</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:'Inter','Apple SD Gothic Neo','Noto Sans KR',sans-serif;background:#fff;color:#0a0a0a;-webkit-font-smoothing:antialiased;overflow-x:hidden;}

    /* NAV */
    .nav{position:fixed;top:0;left:0;right:0;z-index:300;display:flex;align-items:center;justify-content:space-between;padding:14px 20px;background:rgba(255,255,255,0.97);box-shadow:0 1px 0 rgba(0,0,0,0.07);backdrop-filter:blur(12px);}
    .nav-logo img{height:24px;width:auto;}
    .nav-back{font-size:13px;font-weight:600;color:#1a2f8a;text-decoration:none;}

    /* HERO */
    .works-hero{position:relative;height:220px;margin-top:54px;background:url('/images/works-hero.jpg') center/cover no-repeat;display:flex;align-items:flex-end;overflow:hidden;}
    .works-hero-ov{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(5,12,35,0.3),rgba(5,12,35,0.7));}
    .works-hero-content{position:relative;z-index:1;padding:0 20px 28px;}
    .works-hero-label{font-size:9px;font-weight:700;letter-spacing:0.28em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-bottom:6px;}
    .works-hero-title{font-size:clamp(28px,7vw,48px);font-weight:900;letter-spacing:-0.04em;color:#fff;line-height:1.0;}
    .works-hero-count{font-size:12px;color:rgba(255,255,255,0.5);margin-top:6px;}
    .works-hero-count strong{color:#fff;}

    /* 검색바 */
    .search-wrap{padding:16px 20px 0;}
    .search-bar{display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid #e8ecf4;border-radius:50px;padding:10px 16px;transition:border-color 0.2s,box-shadow 0.2s;}
    .search-bar:focus-within{border-color:#1a2f8a;box-shadow:0 0 0 3px rgba(26,47,138,0.08);}
    .search-bar svg{color:#aaa;flex-shrink:0;}
    .search-bar input{border:none;outline:none;font-size:14px;color:#333;background:transparent;width:100%;font-family:inherit;}
    .search-bar input::placeholder{color:#bbb;}

    /* 필터 가로 스크롤 */
    .filters{padding:12px 20px 0;}
    .filter-group{margin-bottom:8px;}
    .filter-label{font-size:10px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#999;margin-bottom:6px;padding:0 2px;}
    .filter-scroll{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;padding-bottom:4px;}
    .filter-scroll::-webkit-scrollbar{display:none;}
    .filter-btn{flex-shrink:0;padding:7px 14px;border:1.5px solid #e8ecf4;border-radius:50px;font-size:12px;font-weight:500;color:#888;background:#fff;cursor:pointer;font-family:inherit;white-space:nowrap;transition:all 0.2s;}
    .filter-btn.on{background:#1a2f8a;color:#fff;border-color:#1a2f8a;font-weight:700;}
    .year-select{width:100%;padding:9px 12px;border:1.5px solid #e8ecf4;border-radius:8px;font-size:13px;color:#333;background:#fff;font-family:inherit;}

    /* 결과 카운트 */
    .result-bar{padding:14px 20px 10px;display:flex;align-items:center;justify-content:space-between;}
    .result-count{font-size:13px;color:#aaa;}
    .result-count strong{color:#0d1a3a;font-size:16px;font-weight:800;}
    .result-reset{font-size:12px;color:#1a2f8a;font-weight:600;background:none;border:none;cursor:pointer;font-family:inherit;}

    /* 카드 그리드 */
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;padding:0 20px 80px;}
    .wc{cursor:pointer;background:#fff;overflow:hidden;border-radius:8px;box-shadow:0 2px 12px rgba(0,0,0,0.06);}
    .wc-img{width:100%;height:140px;overflow:hidden;background:#e8ecf4;background-size:cover;background-position:center;}
    .wc-bg{position:absolute;inset:0;width:100%;height:100%;background-size:cover;background-position:center;transition:transform 0.4s;}
    .wc:active .wc-bg{transform:scale(1.03);}
    .wc-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#e8ecf4;}
    .wc-ph span{font-size:8px;color:#bbb;text-transform:uppercase;letter-spacing:0.1em;}
    .wc-info{padding:10px 12px 12px;border-top:1px solid #f0f4fb;position:relative;}
    .wc-info::before{content:'';position:absolute;bottom:0;left:0;height:2px;background:#1a2f8a;width:0;transition:width 0.3s;}
    .wc:active .wc-info::before{width:100%;}
    .wc-cat{font-size:9px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#1a2f8a;display:block;margin-bottom:4px;}
    .wc-name{font-size:12px;font-weight:700;color:#0d1a3a;line-height:1.4;margin-bottom:4px;}
    .wc-date{font-size:10px;color:#bbb;}

    /* 빈 상태 */
    .empty{display:none;text-align:center;padding:60px 20px;}
    .empty p{font-size:14px;color:#bbb;}
    .empty-btn{background:#1a2f8a;color:#fff;border:none;font-size:12px;font-weight:700;padding:10px 24px;cursor:pointer;margin-top:12px;font-family:inherit;border-radius:6px;}

    /* 모달 */
    .mbg{display:none;position:fixed;inset:0;background:rgba(10,15,40,0.6);z-index:500;align-items:flex-end;justify-content:center;backdrop-filter:blur(4px);}
    .mbg.on{display:flex;}
    .modal{background:#fff;width:100%;max-height:88vh;overflow-y:auto;border-radius:20px 20px 0 0;padding-bottom:40px;}
    .mhead{display:flex;align-items:flex-start;justify-content:space-between;padding:20px 20px 16px;border-bottom:1px solid #f0f0f5;position:sticky;top:0;background:#fff;z-index:1;}
    .mcat{font-size:9px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#1a2f8a;display:block;margin-bottom:6px;}
    .mtitle{font-size:18px;font-weight:800;color:#0d1a3a;letter-spacing:-0.02em;line-height:1.3;padding-right:12px;}
    .mclose{width:32px;height:32px;background:#f5f7fc;border:none;cursor:pointer;color:#999;font-size:14px;display:flex;align-items:center;justify-content:center;border-radius:8px;flex-shrink:0;}
    #mmain-img{width:100%;height:200px;object-fit:cover;display:block;}
    .mthumbs{display:flex;gap:6px;padding:12px 20px;overflow-x:auto;scrollbar-width:none;}
    .mthumbs::-webkit-scrollbar{display:none;}
    .mthumb-item{flex-shrink:0;width:72px;height:52px;cursor:pointer;border:2px solid #e8ecf4;border-radius:6px;overflow:hidden;}
    .mthumb-item.on{border-color:#1a2f8a;}
    .mthumb-item img{width:72px;height:52px;object-fit:cover;display:block;opacity:0.75;}
    .mthumb-item.on img{opacity:1;}
    .minfo{padding:0 20px 20px;}
    .minfo-row{margin-bottom:16px;}
    .minfo-label{font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#bbb;margin-bottom:4px;}
    .minfo-val{font-size:14px;color:#333;font-weight:500;line-height:1.6;}
    .mdesc{font-size:13px;line-height:1.9;color:#666;}
    .mcta{display:block;width:calc(100% - 40px);margin:0 20px;background:#1a2f8a;color:#fff;border:none;font-size:14px;font-weight:700;padding:15px;cursor:pointer;font-family:inherit;text-align:center;border-radius:8px;text-decoration:none;}

    /* 홈 버튼 */
    .m-fab{position:fixed;bottom:20px;right:16px;z-index:100;background:#1a2f8a;color:#fff;border:none;border-radius:50px;padding:11px 18px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 4px 16px rgba(26,47,138,0.4);}
  </style>
</head>
<body>

  <!-- NAV -->
  <nav class="nav">
    <a href="/mobile"><img src="/images/logo.png" alt="EDS 이담에스티" style="height:24px;" /></a>
    <a href="/mobile" class="nav-back">← 홈으로</a>
  </nav>

  <!-- HERO -->
  <div class="works-hero">
    <div class="works-hero-ov"></div>
    <div class="works-hero-content">
      <div class="works-hero-label">EDS 이담에스티</div>
      <h1 class="works-hero-title">ALL PORTFOLIO</h1>
      <p class="works-hero-count">2007년부터 현재까지 <strong>170</strong>개의 프로젝트를 완수했습니다</p>
    </div>
  </div>

  <!-- 검색 -->
  <div class="search-wrap">
    <div class="search-bar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="si" type="text" placeholder="프로젝트명 검색..." />
    </div>
  </div>

  <!-- 필터 가로 스크롤 -->
  <div class="filters">
    <div class="filter-group">
      <div class="filter-label">서비스</div>
      <div class="filter-scroll">
        <button class="filter-btn on" data-f="s" data-v="all">전체</button>
        <button class="filter-btn" data-f="s" data-v="방송제작 스튜디오">방송제작 스튜디오</button>
        <button class="filter-btn" data-f="s" data-v="이러닝 스튜디오">이러닝 스튜디오</button>
        <button class="filter-btn" data-f="s" data-v="LED 디스플레이">LED 디스플레이</button>
        <button class="filter-btn" data-f="s" data-v="스마트 강의실">스마트 강의실</button>
        <button class="filter-btn" data-f="s" data-v="아카이브 시스템">아카이브 시스템</button>
        <button class="filter-btn" data-f="s" data-v="방송 인프라">방송 인프라</button>
        <button class="filter-btn" data-f="s" data-v="전시체험">전시체험</button>
        <button class="filter-btn" data-f="s" data-v="화상회의">화상회의</button>
      </div>
    </div>
    <div class="filter-group">
      <div class="filter-label">고객</div>
      <div class="filter-scroll">
        <button class="filter-btn on" data-f="c" data-v="all">전체</button>
        <button class="filter-btn" data-f="c" data-v="공공기관">공공기관</button>
        <button class="filter-btn" data-f="c" data-v="교육기관">교육기관</button>
        <button class="filter-btn" data-f="c" data-v="기업">기업</button>
        <button class="filter-btn" data-f="c" data-v="종교">종교</button>
      </div>
    </div>
    <div class="filter-group">
      <div class="filter-label">기간</div>
      <select id="yr-select" class="year-select">
        <option value="all">전체</option>
        <option value="2026">2026년</option>
        <option value="2025">2025년</option>
        <option value="2024">2024년</option>
        <option value="2023">2023년</option>
        <option value="2022">2022년</option>
        <option value="2021">2021년</option>
        <option value="2020">2020년</option>
        <option value="2019">2019년</option>
        <option value="2018">2018년</option>
        <option value="2017">2017년</option>
        <option value="2016">2016년</option>
        <option value="2015">2015년</option>
        <option value="old">2015년 이전</option>
      </select>
    </div>
  </div>

  <!-- 결과 바 -->
  <div class="result-bar">
    <span class="result-count"><strong id="rn">170</strong>개의 프로젝트</span>
    <button class="result-reset" onclick="reset()">초기화</button>
  </div>

  <!-- 카드 그리드 -->
  <div class="grid" id="grid"></div>
  <div class="empty" id="empty">
    <p>검색 결과가 없습니다</p>
    <button class="empty-btn" onclick="reset()">필터 초기화</button>
  </div>

  <!-- 모달 -->
  <div class="mbg" id="mbg">
    <div class="modal">
      <div class="mhead">
        <div style="flex:1;min-width:0;">
          <span class="mcat" id="mcat"></span>
          <div class="mtitle" id="mtitle"></div>
        </div>
        <button class="mclose" onclick="closeModal()">✕</button>
      </div>
      <img id="mmain-img" src="data:," alt="">
      <div class="mthumbs" id="mth"></div>
      <div class="minfo">
        <div class="minfo-row"><div class="minfo-label">구축일자</div><div class="minfo-val" id="mdate"></div></div>
        <div class="minfo-row"><div class="minfo-label">고객유형</div><div class="minfo-val" id="mclient"></div></div>
        <div class="minfo-row"><div class="minfo-label">프로젝트 개요</div><p class="mdesc" id="mdesc"></p></div>
      </div>
      <a href="/mobile#m-contact" class="mcta" onclick="closeModal()">도입 문의하기 →</a>
    </div>
  </div>

  <button class="m-fab" onclick="location.href='/mobile'">💬 문의하기</button>

<script type="application/json" id="hardcoded-projects-data" set:html={JSON.stringify(projects)}></script>
<script is:inline>
const hardcodedProjects = JSON.parse(document.getElementById('hardcoded-projects-data').textContent);

let allProjects = [...hardcodedProjects];
let sv='all',cl='all',yr='all',q='',cp=null;

async function loadAdminProjects() {
  try {
    const res = await fetch('/api/admin/projects');
    if (!res.ok) return;
    const adminProjects = await res.json();
    const hardcodedIds = new Set(hardcodedProjects.map(p => p.id));
    const newOnes = adminProjects.filter(p => !hardcodedIds.has(p.id));
    if (newOnes.length > 0) { allProjects = [...newOnes, ...hardcodedProjects]; render(); }
  } catch(e) {}
}

function render(){
  const fl=allProjects.filter(p=>(sv==='all'||p.service===sv)&&(cl==='all'||p.client===cl)&&(yr==='all'||(yr==='old'?parseInt(p.date)<2015:p.date.startsWith(yr)))&&(!q||p.title.includes(q)||(p.overview||''). includes(q)));
  const g=document.getElementById('grid'),e=document.getElementById('empty');
  document.getElementById('rn').textContent=fl.length;
  if(!fl.length){g.style.display='none';e.style.display='block';return;}
  g.style.display='grid';e.style.display='none';
  g.innerHTML=fl.map(p=>{
    const hi=p.images&&p.images.length>0;
    const cardImg = hi ? p.images[0] : '';
    const cardStyle = hi ? 'height:140px;background-image:url(' + cardImg + ');background-size:cover;background-position:center;' : 'height:140px;';
    return '<div class="wc" onclick="openModal(' + p.id + ')">' + '<div class="wc-img" style="' + cardStyle + '"></div>'
      +'<div class="wc-info">'
        +'<span class="wc-cat">'+p.service+'</span>'
        +'<p class="wc-name">'+p.title+'</p>'
        +'<span class="wc-date">'+p.date+'</span>'
      +'</div>'
      +'</div>';
  }).join('');
}

function openModal(id){
  const p=allProjects.find(x=>x.id===id);
  if(!p) return;
  cp=p;
  document.getElementById('mcat').textContent=p.service;
  document.getElementById('mtitle').textContent=p.title;
  document.getElementById('mdate').textContent=p.date;
  document.getElementById('mclient').textContent=p.client;
  document.getElementById('mdesc').textContent=p.overview||'';
  const mainImg=document.getElementById('mmain-img');
  const th=document.getElementById('mth');
  if(p.images&&p.images.length>0){
    mainImg.src=p.images[0];
    th.innerHTML=p.images.map((img,i)=>
      '<div class="mthumb-item'+(i===0?' on':'')+'" onclick="selImg(\''+img+'\',this)" style="flex-shrink:0;width:72px;height:52px;min-width:72px;min-height:52px;max-width:72px;max-height:52px;overflow:hidden;border:2px solid '+(i===0?'#1a2f8a':'#e8ecf4')+';border-radius:6px;display:inline-block;"><img src="'+img+'" alt="" style="width:72px;height:52px;object-fit:cover;display:block;"></div>'
    ).join('');
  } else {
    mainImg.src='data:,';
    th.innerHTML='';
  }
  document.getElementById('mbg').classList.add('on');
  document.body.style.overflow='hidden';
}

function selImg(url,el){
  document.getElementById('mmain-img').src=url;
  document.querySelectorAll('.mthumb-item').forEach(t=>t.classList.remove('on'));
  el.classList.add('on');
}

function closeModal(){
  document.getElementById('mbg').classList.remove('on');
  document.body.style.overflow='';
}

document.getElementById('mbg').addEventListener('click',e=>{if(e.target===document.getElementById('mbg')) closeModal();});

document.querySelectorAll('.filter-btn').forEach(b=>b.addEventListener('click',()=>{
  const f=b.dataset.f,v=b.dataset.v;
  document.querySelectorAll('.filter-btn[data-f="'+f+'"]').forEach(x=>x.classList.remove('on'));
  b.classList.add('on');
  if(f==='s') sv=v; else cl=v;
  render();
}));

document.getElementById('yr-select').addEventListener('change',e=>{yr=e.target.value;render();});

document.getElementById('si').addEventListener('input',e=>{q=e.target.value.trim();render();});
function reset(){sv='all';cl='all';yr='all';q='';document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('on'));document.querySelectorAll('.filter-btn[data-v="all"]').forEach(b=>b.classList.add('on'));document.getElementById('yr-select').value='all';document.getElementById('si').value='';render();}
document.addEventListener('keydown',e=>{if(e.key==='Escape') closeModal();});
render();

function openFromUrlParam(){
  const params = new URLSearchParams(window.location.search);
  const openId = params.get('open');
  if (!openId) return;
  const id = parseInt(openId);
  const p = allProjects.find(x => x.id === id);
  if (p) {
    openModal(id);
    history.replaceState(null, '', '/mobile/works');
  }
}

loadAdminProjects().then(openFromUrlParam);
</script>
</body>
</html>
