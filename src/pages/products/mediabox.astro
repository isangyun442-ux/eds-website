---
// src/pages/products/mediabox.astro
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<link rel="icon" href="/favicon.ico"/>
<title>mediabox — EDS 이담에스티</title>
<style>
:root {
  --bg:       #08090d;
  --bg2:      #0d1117;
  --surface:  #111827;
  --surface2: #1a2235;
  --border:   #1f2d40;
  --border-s: #141e2c;
  --accent:   #2563eb;
  --accent-b: #3b82f6;
  --glow:     rgba(37,99,235,0.12);
  --glow-b:   rgba(37,99,235,0.06);
  --text:     #dde4ed;
  --mid:      #9dafc3;
  --muted:    #5a6d84;
  --rec:      #22c55e;
  --rec-g:    rgba(34,197,94,0.18);
  --tag:      rgba(37,99,235,0.10);
  --sans:     -apple-system,'Segoe UI','Helvetica Neue',sans-serif;
  --mono:     'SF Mono','Consolas','Courier New',monospace;
  --r:        8px;
  --r2:       12px;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--sans);background:var(--bg);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased;position:relative;}
body::before,body::after{content:'';position:fixed;pointer-events:none;z-index:0;}
body::before{
  inset:0;
  background:
    radial-gradient(ellipse 80% 55% at -5% 25%, rgba(30,80,180,.28) 0%, transparent 60%),
    radial-gradient(ellipse 65% 55% at 108% 75%, rgba(6,160,150,.18) 0%, transparent 55%),
    radial-gradient(ellipse 50% 40% at 50% 110%, rgba(20,80,160,.12) 0%, transparent 60%);
}
body::after{display:none;}
body > *{position:relative;z-index:1;}

@keyframes pulse-rec {
  0%,100%{opacity:1;box-shadow:0 0 0 0 var(--rec-g);}
  50%{opacity:.5;box-shadow:0 0 0 6px transparent;}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;}}

/* NAV */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:300;
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 80px;
  background:rgba(255,255,255,0.97);
  box-shadow:0 1px 0 rgba(0,0,0,0.07);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
}
.nav-logo{height:28px;display:flex;align-items:center;text-decoration:none;}
.nav-logo img{height:28px;width:auto;object-fit:contain;}
.nav-menu{display:flex;align-items:center;gap:48px;}
.nav-item{position:relative;}
.nav-link{
  display:block;
  font-family:'Nanum Square','Apple SD Gothic Neo',sans-serif;
  font-size:20px;font-weight:400;letter-spacing:0.05em;
  text-decoration:none;cursor:pointer;color:#1a1a1a;
  padding:8px 4px;border-radius:6px;transition:all 0.2s;white-space:nowrap;
}
.nav-link:hover{color:#1a2f8a;}
.nav-link.active{color:#1a2f8a;}
.nav-item.has-drop:hover .nav-link{color:#1a2f8a;}
.nav-drop{
  position:absolute;top:calc(100% + 6px);left:0;min-width:160px;
  background:#fff;border-radius:10px;
  border:1px solid rgba(0,0,0,0.08);box-shadow:0 8px 40px rgba(0,0,0,0.12);
  padding:8px 0;opacity:0;visibility:hidden;transform:translateY(-6px);
  transition:opacity 0.2s,transform 0.2s,visibility 0.2s;
}
.nav-item.has-drop:hover .nav-drop{opacity:1;visibility:visible;transform:translateY(0);}
.drop-link{
  display:block;font-size:14px;font-weight:500;color:#444;
  text-decoration:none;padding:10px 20px;
  transition:background 0.15s,color 0.15s;white-space:nowrap;
}
.drop-link:hover{background:rgba(26,47,138,0.05);color:#1a2f8a;}
.nav-right{display:flex;align-items:center;gap:8px;}
.lang-switch{display:flex;gap:6px;margin-right:4px;}
.lang-sw-btn{font-size:11px;font-weight:700;padding:4px 8px;border:1.5px solid #ddd;background:transparent;cursor:pointer;border-radius:4px;color:#666;font-family:inherit;transition:all 0.2s;}
.lang-sw-btn.active{background:#1a2f8a;color:#fff;border-color:#1a2f8a;}
.nav-cta{
  font-size:13px;font-weight:700;padding:9px 20px;
  background:#1a2f8a;color:#fff;border:none;cursor:pointer;
  border-radius:6px;font-family:inherit;transition:background 0.2s;text-decoration:none;
}
.nav-cta:hover{background:#142580;}
@media(max-width:768px){.nav{padding:12px 20px;}.nav-menu{display:none;}}

/* HERO */
.hero{
  min-height:88vh;display:flex;flex-direction:column;justify-content:center;
  padding:100px 52px 0;background:transparent;position:relative;overflow:hidden;
}
.hero::after{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(ellipse 55% 60% at 72% 45%,rgba(37,99,235,.09) 0%,transparent 70%);
}
.hero-inner{display:grid;grid-template-columns:1fr 1.4fr;gap:48px;align-items:center;max-width:1280px;margin:0 auto;position:relative;z-index:1;}
.hero-h1{font-size:clamp(30px,3.8vw,52px);font-weight:800;line-height:1.14;
  letter-spacing:-.035em;text-wrap:balance;margin-bottom:22px;}
.hero-h1 em{color:var(--accent-b);font-style:normal;}
.hero-lead{font-size:14.5px;color:var(--mid);line-height:1.78;max-width:460px;margin-bottom:38px;}
.hero-actions{display:flex;gap:12px;}
.btn-p{background:var(--accent);color:#fff;border:none;border-radius:var(--r);
  padding:12px 24px;font-size:14px;font-weight:600;cursor:pointer;transition:opacity .2s;text-decoration:none;display:inline-block;}
.btn-p:hover{opacity:.85;}
.btn-s{background:transparent;color:var(--mid);border:1px solid var(--border);
  border-radius:var(--r);padding:12px 24px;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;text-decoration:none;display:inline-block;}
.btn-s:hover{border-color:var(--accent-b);color:var(--accent-b);}

.hero-visual{display:flex;flex-direction:column;gap:14px;}
.hw-img-wrap{width:100%;display:flex;align-items:center;justify-content:center;padding:8px 0;}
.hw-img-wrap img{width:100%;max-width:100%;height:auto;object-fit:contain;
  filter:drop-shadow(0 24px 64px rgba(37,99,235,.22));}

/* SECTION */
.s-wrap{padding:80px 52px;}
.s-wrap.alt{background:rgba(13,17,23,.7);}
.s-inner{max-width:1200px;margin:0 auto;}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.15em;color:var(--accent-b);
  text-transform:uppercase;margin-bottom:10px;}
.s-title{font-size:clamp(22px,2.8vw,34px);font-weight:800;letter-spacing:-.03em;
  text-wrap:balance;margin-bottom:12px;}
.s-sub{font-size:14px;color:var(--mid);line-height:1.75;max-width:520px;margin-bottom:48px;}

/* FEAT GRID */
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.feat{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);
  padding:26px 26px 30px;transition:border-color .2s,box-shadow .2s;
}
.feat:hover{border-color:rgba(37,99,235,.35);box-shadow:0 0 0 1px var(--glow-b),0 6px 28px rgba(0,0,0,.25);}
.feat-icon{width:36px;height:36px;background:var(--glow);border-radius:8px;
  display:flex;align-items:center;justify-content:center;margin-bottom:16px;}
.feat-icon svg{width:18px;height:18px;}
.feat-t{font-size:14.5px;font-weight:700;letter-spacing:-.01em;margin-bottom:8px;}
.feat-d{font-size:13px;color:var(--mid);line-height:1.65;}

/* PIPE */
.pipe{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);
  padding:28px 32px;display:flex;align-items:center;margin-top:40px;overflow-x:auto;
}
.pipe-step{flex:1;min-width:80px;text-align:center;position:relative;}
.pipe-step+.pipe-step::before{
  content:'';position:absolute;left:0;top:17px;width:50%;height:1px;
  background:var(--border);z-index:0;
}
.pipe-step+.pipe-step::after{
  content:'';position:absolute;right:0;top:17px;width:50%;height:1px;
  background:var(--border);z-index:0;
}
.p-node{
  width:34px;height:34px;border-radius:50%;
  background:var(--surface2);border:1.5px solid rgba(37,99,235,.3);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 10px;position:relative;z-index:1;
}
.p-label{font-size:11px;font-weight:700;color:var(--mid);}
.p-sub{font-family:var(--mono);font-size:9.5px;color:var(--muted);margin-top:2px;}

/* DETAIL ROWS */
.detail-row{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;padding:56px 0;border-bottom:1px solid var(--border-s);}
.detail-row:last-child{border-bottom:none;}
.detail-row.reverse{direction:rtl;}
.detail-row.reverse > *{direction:ltr;}
.detail-img{border-radius:var(--r2);overflow:hidden;border:1px solid var(--border);}
.detail-img img{width:100%;display:block;height:auto;}
.detail-label{font-size:13px;font-weight:700;color:var(--text);margin-bottom:10px;}
.detail-title{font-size:20px;font-weight:800;letter-spacing:-.02em;margin-bottom:16px;}
.detail-list{list-style:none;}
.detail-list li{font-size:13px;color:var(--mid);line-height:1.65;padding:6px 0 6px 16px;position:relative;border-bottom:1px dashed var(--border-s);}
.detail-list li:last-child{border-bottom:none;}
.detail-list li::before{content:'·';position:absolute;left:0;color:var(--accent-b);font-weight:700;font-size:16px;line-height:1.4;}

/* SCENARIOS */
.scn-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
.scn{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:26px;}
.scn-tag{font-family:var(--mono);font-size:10.5px;color:var(--accent-b);letter-spacing:.1em;margin-bottom:12px;}
.scn-t{font-size:15px;font-weight:700;letter-spacing:-.01em;margin-bottom:8px;}
.scn-d{font-size:13px;color:var(--mid);line-height:1.65;margin-bottom:14px;}
.scn-chips{display:flex;flex-wrap:wrap;gap:6px;}
.chip{font-size:11px;background:var(--tag);border:1px solid rgba(37,99,235,.12);
  color:var(--mid);border-radius:4px;padding:3px 8px;}

/* OPS + SPEC */
.two{display:grid;grid-template-columns:1fr 1fr;gap:56px;margin-top:48px;}
.ops-list{list-style:none;margin-top:20px;}
.ops-list li{display:grid;grid-template-columns:20px 1fr;gap:12px;padding:13px 0;
  border-bottom:1px solid var(--border-s);align-items:start;}
.ops-list li:last-child{border-bottom:none;}
.ops-d{font-family:var(--mono);font-size:12px;color:var(--accent-b);font-weight:700;line-height:1.8;}
.ops-list b{display:block;font-size:13px;font-weight:700;margin-bottom:2px;}
.ops-list p{font-size:12px;color:var(--mid);line-height:1.5;}

.spec-wrap{overflow-x:auto;margin-top:24px;}
.spec{width:100%;border-collapse:collapse;font-size:13px;}
.spec thead th{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;
  color:var(--muted);background:var(--surface2);padding:10px 14px;border-bottom:1px solid var(--border);font-weight:600;}
.spec tbody td{padding:12px 14px;border-bottom:1px solid var(--border-s);vertical-align:top;}
.spec tbody td:first-child{font-weight:600;color:var(--mid);width:38%;}
.spec tbody td:last-child{font-family:var(--mono);font-size:12px;color:var(--text);}
.spec tbody tr:last-child td{border-bottom:none;}
.spec tbody tr:hover td{background:var(--glow-b);}

.roadmap{background:var(--surface);border:1px dashed rgba(37,99,235,.28);border-radius:var(--r2);
  padding:22px 28px;margin-top:28px;}
.rm-t{font-size:12.5px;font-weight:700;color:var(--accent-b);margin-bottom:10px;}
.rm-chips{display:flex;flex-wrap:wrap;gap:7px;}
.rm-chip{font-size:11.5px;color:var(--mid);background:rgba(37,99,235,.06);
  border:1px solid rgba(37,99,235,.12);border-radius:4px;padding:4px 10px;}

/* CTA */
.cta{background:var(--surface);border-top:1px solid var(--border);padding:80px 52px;}
.cta-inner{max-width:640px;margin:0 auto;text-align:center;}
.cta-t{font-size:clamp(24px,3vw,38px);font-weight:800;letter-spacing:-.035em;margin-bottom:14px;}
.cta-s{font-size:14px;color:var(--mid);line-height:1.75;margin-bottom:36px;}
.cta-logo{height:36px;width:auto;margin:0 auto 32px;display:block;}
.cta-meta{display:flex;justify-content:center;gap:40px;margin-top:40px;flex-wrap:wrap;}
.cta-item strong{display:block;font-size:14px;font-weight:700;color:var(--mid);margin-bottom:2px;}
.cta-item span{font-size:12px;color:var(--muted);}

@media(max-width:960px){
  .hero-inner,.two{grid-template-columns:1fr;}
  .feat-grid{grid-template-columns:1fr 1fr;}
  .scn-grid{grid-template-columns:1fr;}
  .s-wrap,.cta,.hero{padding-left:24px;padding-right:24px;}
}
@media(max-width:600px){
  .feat-grid{grid-template-columns:1fr;}
}
</style>
</head>
<body>

<svg id="wave-bg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice"
  style="position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0;" aria-hidden="true">
  <defs>
    <linearGradient id="sweep" x1="-0.5" y1="0" x2="0.5" y2="0" gradientUnits="objectBoundingBox">
      <stop offset="0"   stop-color="#0a1628" stop-opacity="0"/>
      <stop offset="0.4" stop-color="#1a4080" stop-opacity="0.18"/>
      <stop offset="0.6" stop-color="#0e6ea8" stop-opacity="0.12"/>
      <stop offset="1"   stop-color="#0a1628" stop-opacity="0"/>
      <animateTransform attributeName="gradientTransform" type="translate"
        from="-1 0" to="2 0" dur="16s" repeatCount="indefinite"/>
    </linearGradient>
    <linearGradient id="wg1" x1="0" y1="0" x2="1" y2="0" gradientUnits="objectBoundingBox">
      <stop offset="0"   stop-color="#1e5fa8" stop-opacity="0"/>
      <stop offset="0.4" stop-color="#2563eb" stop-opacity="0.18"/>
      <stop offset="1"   stop-color="#06b6d4" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="wg2" x1="0" y1="0" x2="1" y2="0" gradientUnits="objectBoundingBox">
      <stop offset="0"   stop-color="#06b6d4" stop-opacity="0"/>
      <stop offset="0.5" stop-color="#0ea5e9" stop-opacity="0.12"/>
      <stop offset="1"   stop-color="#2563eb" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <rect x="0" y="0" width="1440" height="900" fill="url(#sweep)"/>
  <path d="M-100 500 C200 300 500 650 800 420 S1200 250 1540 400 L1540 900 L-100 900 Z" fill="url(#wg1)"/>
  <path d="M-80 700 C250 520 550 770 850 580 S1250 400 1540 580 L1540 900 L-80 900 Z"   fill="url(#wg2)"/>
  <path d="M-100 180 C300 60 600 330 900 160 S1250 30 1540 180 L1540 0 L-100 0 Z"        fill="url(#wg1)" fill-opacity="0.5"/>
</svg>

<!-- NAV -->
<nav class="nav">
  <a href="/" class="nav-logo"><img src="/images/logo.png" alt="EDS 이담에스티"/></a>
  <div class="nav-menu">
    <div class="nav-item has-drop">
      <span class="nav-link" data-nav="0">회사소개</span>
      <div class="nav-drop">
        <a href="/#sec2" class="drop-link" data-drop="0">인사말</a>
        <a href="/#sec6" class="drop-link" data-drop="1">연혁</a>
        <a href="/#sec-cert" class="drop-link" data-drop="2">인증현황</a>
        <a href="/#sec7" class="drop-link" data-drop="3">오시는 길</a>
      </div>
    </div>
    <div class="nav-item">
      <a href="/#sec3" class="nav-link" data-nav="1">사업분야</a>
    </div>
    <div class="nav-item">
      <a href="/works" class="nav-link" data-nav="2">구축사례</a>
    </div>
    <div class="nav-item has-drop">
      <span class="nav-link" data-nav="3">제품/시스템 소개</span>
      <div class="nav-drop">
        <a href="/products/mediabox" class="drop-link" data-drop="4">미디어박스</a>
        <a href="/products/server" class="drop-link" data-drop="5">컴퓨터 서버</a>
        <a href="/products/disk-array" class="drop-link" data-drop="6">디스크 어레이</a>
        <a href="/products/led" class="drop-link" data-drop="7">LED 전광판</a>
      </div>
    </div>
    <div class="nav-item">
      <a href="/#sec7" class="nav-link" data-nav="4">문의</a>
    </div>
  </div>
  <div class="nav-right">
    <div class="lang-switch">
      <button class="lang-sw-btn active" onclick="setLang('ko')">KO</button>
      <button class="lang-sw-btn" onclick="setLang('en')">EN</button>
    </div>
    <a href="/#sec7" class="nav-cta" id="nav-cta-btn">도입 문의</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div>
      <img src="/images/products/mediabox-v2/logo.png" alt="mediabox" style="height:32px;width:auto;margin-bottom:22px;display:block;"/>
      <h1 class="hero-h1" id="hero-h1">8개 채널을<br><em>기록하고, 검색하고,</em><br>브리핑합니다.</h1>
      <p class="hero-lead" id="hero-lead">지상파·보도·종합편성 8채널을 24시간 자동 녹화하고, 방송 자막을 문장 단위로 검색하며, AI 이슈 브리핑까지 한 대에서 끝내는 하드웨어 일체형 미디어 인텔리전스 시스템입니다.</p>
      <div class="hero-actions">
        <a href="/#sec7" class="btn-p" id="hero-btn1">도입 문의하기</a>
        <a href="#" class="btn-s" id="hero-btn2">제품 소개서 받기</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hw-img-wrap">
        <img src="/images/products/mediabox-v2/hw-front.png" alt="MediaBox V2 하드웨어"/>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<div class="s-wrap alt" id="feat">
<div class="s-inner">
  <div class="eyebrow" id="feat-eyebrow">Core Features</div>
  <h2 class="s-title" id="feat-title">모든 방송 모니터링을<br>한 대에서</h2>
  <p class="s-sub" id="feat-sub">녹화부터 자막 추출, 형태소 검색, AI 브리핑, 스토리지 자동 관리까지 — 별도 서버 없이 하드웨어 한 대로 완결됩니다.</p>

  <div class="feat-grid">
    <div class="feat">
      <div class="feat-icon"><svg viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="4" fill="var(--accent)"/><circle cx="10" cy="10" r="7.5" stroke="var(--accent)" stroke-width="1.2" opacity=".35"/></svg></div>
      <div class="feat-t" data-feat-t="0">8채널 24시간 자동 녹화</div>
      <div class="feat-d" data-feat-d="0">전용 수신 카드 2매로 8채널 동시 상시 녹화. 방송 원본(TS)과 웹 재생본(MP4)을 함께 생성해 화질 보존과 빠른 열람을 모두 지원합니다.</div>
    </div>
    <div class="feat">
      <div class="feat-icon"><svg viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5" stroke="var(--accent)" stroke-width="1.4"/><path d="M12.5 12.5l4 4" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round"/></svg></div>
      <div class="feat-t" data-feat-t="1">방송 자막 자동 추출 · 전문 검색</div>
      <div class="feat-d" data-feat-d="1">녹화와 동시에 방송 자막을 추출하고 한국어 형태소 분석으로 조사·어미가 달라도 원하는 발언을 정확히 찾아냅니다.</div>
    </div>
    <div class="feat">
