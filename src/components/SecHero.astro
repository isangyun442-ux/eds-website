---
// src/components/SecHero.astro
---
<section class="sec s0" id="sec0">

  <!-- 영상 영역 100vh -->
  <div class="video-wrap">
    <video id="heroDeskVideo" src="https://uacyx65ftsezenuu.public.blob.vercel-storage.com/eds-hero/1788166253626-main.mp4" autoplay muted loop playsinline preload="auto"></video>
    <div class="hero-chapters" id="heroChapters">
      <button class="hero-chap" data-t="0">회사소개</button>
      <button class="hero-chap" data-t="8">연혁</button>
      <button class="hero-chap" data-t="28">사업영역</button>
      <button class="hero-chap" data-t="48">기술조직</button>
      <button class="hero-chap" data-t="68">포트폴리오</button>
      <button class="hero-chap" data-t="92">협력사</button>
    </div>
    <div class="scroll-hint">
      <span class="scroll-label">SCROLL</span>
      <div class="scroll-arrow">
        <svg width="20" height="28" viewBox="0 0 20 28" fill="none">
          <rect x="1" y="1" width="18" height="26" rx="9" stroke="rgba(150,150,150,0.7)" stroke-width="1.5"/>
          <rect class="scroll-dot" x="9" y="5" width="2" height="5" rx="1" fill="rgba(150,150,150,0.9)"/>
        </svg>
      </div>
    </div>
  </div>

</section>

<style>
  .s0 { display: flex; flex-direction: column; position: relative; }

  /* 영상 100vh */
  .video-wrap {
    position: relative; height: 100vh;
    overflow: hidden; background: transparent; flex-shrink: 0;
  }
  .video-wrap video {
    position: absolute; top: 0; left: 50%;
    min-width: 100%; min-height: 100%;
    width: auto; height: auto;
    transform: translateX(-50%);
    object-fit: cover;
    object-position: top center;
  }

  /* 히어로 영상 구간 선택 — 기본은 숨김, 영상 위 호버 시에만 노출 */
  .hero-chapters {
    position: absolute;
    bottom: 92px; left: 50%;
    transform: translateX(-50%) translateY(8px);
    display: flex; gap: 6px;
    z-index: 10;
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .video-wrap:hover .hero-chapters,
  .video-wrap:focus-within .hero-chapters {
    opacity: 1; pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .hero-chap {
    font-family: inherit;
    font-size: 12px; font-weight: 600; letter-spacing: -0.01em;
    color: rgba(255,255,255,0.75);
    background: rgba(10,16,40,0.55);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border: 0.5px solid rgba(255,255,255,0.15);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .hero-chap:hover { color: #fff; background: rgba(26,47,138,0.65); border-color: rgba(255,255,255,0.3); }
  .hero-chap.active { color: #fff; background: rgba(26,47,138,0.85); border-color: rgba(255,255,255,0.4); }

  @media (max-width: 960px) {
    .hero-chapters { display: none; }
  }

  .scroll-hint {
    position: absolute;
    bottom: 36px; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    animation: scrollFade 2.5s ease-in-out infinite;
    cursor: pointer; z-index: 10;
  }
  .scroll-label {
    font-size: 10px; font-weight: 700; letter-spacing: 0.2em;
    color: rgba(255,255,255,0.5);
  }
  .scroll-dot {
    animation: scrollDot 2.5s ease-in-out infinite;
  }
  @keyframes scrollDot {
    0%   { transform: translateY(0); opacity: 1; }
    60%  { transform: translateY(10px); opacity: 0.2; }
    61%  { transform: translateY(0); opacity: 0; }
    70%  { opacity: 1; }
    100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes scrollFade {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  @media (max-width: 768px) {
    #sec0, #sec0.active, #sec0.sec {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }
</style>

<script>
  const hint = document.querySelector('.scroll-hint') as HTMLElement | null;
  if (hint) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 80) hint.style.opacity = '0';
      else hint.style.opacity = '1';
    }, { passive: true });
    hint.addEventListener('click', () => {
      window.scrollBy({ top: window.innerHeight, behavior: 'smooth' });
    });
  }

  const heroVideo = document.getElementById('heroDeskVideo') as HTMLVideoElement | null;
  const chapterBtns = Array.from(document.querySelectorAll('.hero-chap')) as HTMLButtonElement[];
  if (heroVideo && chapterBtns.length) {
    const times = chapterBtns.map((b) => parseFloat(b.dataset.t || '0'));

    chapterBtns.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        heroVideo.currentTime = times[i];
      });
    });

    heroVideo.addEventListener('timeupdate', () => {
      const t = heroVideo.currentTime;
      let activeIdx = 0;
      for (let i = 0; i < times.length; i++) {
        if (t >= times[i]) activeIdx = i;
      }
      chapterBtns.forEach((btn, i) => btn.classList.toggle('active', i === activeIdx));
    });
  }
</script>
