---
// src/components/SecHero.astro
---
<section class="sec s0" id="sec0">

  <!-- 영상 영역 100vh -->
  <div class="video-wrap">
    <video id="heroDeskVideo" src="/videos/main.mp4" autoplay muted loop playsinline preload="auto"></video>
    <div class="hero-timeline" id="heroTimeline">
      <div class="hero-timeline-segments" id="heroTimelineSegments">
        <div class="hero-seg" data-t="0"><span class="hero-seg-label">회사소개</span></div>
        <div class="hero-seg" data-t="8"><span class="hero-seg-label">연혁</span></div>
        <div class="hero-seg" data-t="28"><span class="hero-seg-label">사업영역</span></div>
        <div class="hero-seg" data-t="48"><span class="hero-seg-label">기술조직</span></div>
        <div class="hero-seg" data-t="68"><span class="hero-seg-label">포트폴리오</span></div>
        <div class="hero-seg" data-t="92"><span class="hero-seg-label">협력사</span></div>
      </div>
      <div class="hero-timeline-track" id="heroTimelineTrack">
        <div class="hero-timeline-progress" id="heroTimelineProgress"></div>
        <div class="hero-timeline-marks" id="heroTimelineMarks">
          <div class="hero-mark" data-t="0"></div>
          <div class="hero-mark" data-t="8"></div>
          <div class="hero-mark" data-t="28"></div>
          <div class="hero-mark" data-t="48"></div>
          <div class="hero-mark" data-t="68"></div>
          <div class="hero-mark" data-t="92"></div>
        </div>
      </div>
    </div>
    <div class="scroll-hint">
      <span class="scroll-label">SCROLL</span>
      <div class="scroll-arrow">
        <svg width="20" height="28" viewBox="0 0 20 28" fill="none">
          <rect x="1" y="1" width="18" height="26" rx="9" stroke="rgba(150,150,150,0.7)" stroke-width="1.5"/>
          <rect class="scroll-dot" x="9" y="5" width="2" height="5" rx="1" fill="rgba(150,150,150,0.9)"/>
        </svg>
      </div>
    </div>
  </div>

</section>

<style>
  .s0 { display: flex; flex-direction: column; position: sticky; top: 0; z-index: 0; }

  /* 영상 100vh */
  .video-wrap {
    position: relative; height: 100vh;
    overflow: hidden; background: transparent; flex-shrink: 0;
  }
  .video-wrap video {
    position: absolute; top: 0; left: 50%;
    min-width: 100%; min-height: 100%;
    width: auto; height: auto;
    transform: translateX(-50%);
    object-fit: cover;
    object-position: top center;
  }

  /* 히어로 영상 타임라인 — 하단 호버 시에만 노출되는 유튜브 스타일 구간 탐색 바 */
  .hero-timeline {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    display: flex; flex-direction: column;
    padding: 0 40px 14px;
    z-index: 10;
    opacity: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(0,0,0,0.3) 0%, transparent 100%);
    transition: opacity 0.25s ease;
  }
  .video-wrap:hover .hero-timeline,
  .video-wrap:focus-within .hero-timeline {
    opacity: 1; pointer-events: auto;
  }

  /* 구간 호버 영역 — 눈금이 아니라 구간 전체에 호버하면 이름 표시 */
  .hero-timeline-segments {
    position: relative;
    width: 100%; height: 30px;
  }
  .hero-seg {
    position: absolute; top: 0; height: 100%;
  }
  .hero-seg-label {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    font-size: 11px; font-weight: 600; letter-spacing: -0.01em;
    color: #fff;
    background: rgba(10,16,40,0.55);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    padding: 5px 10px; border-radius: 6px;
    white-space: nowrap;
    opacity: 0; pointer-events: none;
    transition: opacity 0.15s ease;
  }
  .hero-seg:hover .hero-seg-label { opacity: 1; }

  .hero-timeline-track {
    position: relative;
    width: 100%; height: 4px;
    background: rgba(255,255,255,0.18);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    border-radius: 999px;
    cursor: pointer;
    transition: height 0.15s ease;
  }
  .hero-timeline-track:hover { height: 7px; }
  .hero-timeline-progress {
    position: absolute; top: 0; left: 0; height: 100%;
    width: 0%;
    background: rgba(91,124,250,0.7);
    border-radius: 999px;
    pointer-events: none;
  }
  .hero-timeline-marks {
    position: absolute; inset: 0; pointer-events: none;
  }
  .hero-mark {
    position: absolute; top: 50%; left: 0;
    width: 3px; height: 12px;
    transform: translate(-50%, -50%);
    background: rgba(255,255,255,0.75);
    border-radius: 2px;
  }
  .hero-mark.active { background: rgba(255,255,255,0.95); height: 16px; }

  @media (max-width: 960px) {
    .hero-timeline { display: none; }
  }

  .scroll-hint {
    position: absolute;
    bottom: 36px; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    animation: scrollFade 2.5s ease-in-out infinite;
    cursor: pointer; z-index: 10;
  }
  .scroll-label {
    font-size: 10px; font-weight: 700; letter-spacing: 0.2em;
    color: rgba(255,255,255,0.5);
  }
  .scroll-dot {
    animation: scrollDot 2.5s ease-in-out infinite;
  }
  @keyframes scrollDot {
    0%   { transform: translateY(0); opacity: 1; }
    60%  { transform: translateY(10px); opacity: 0.2; }
    61%  { transform: translateY(0); opacity: 0; }
    70%  { opacity: 1; }
    100% { transform: translateY(0); opacity: 1; }
  }
  @keyframes scrollFade {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  @media (max-width: 768px) {
    #sec0, #sec0.active, #sec0.sec {
      display: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  }
</style>

<script>
  const hint = document.querySelector('.scroll-hint') as HTMLElement | null;
  if (hint) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 80) hint.style.opacity = '0';
      else hint.style.opacity = '1';
    }, { passive: true });
    hint.addEventListener('click', () => {
      window.scrollBy({ top: window.innerHeight, behavior: 'smooth' });
    });
  }

  const heroVideo = document.getElementById('heroDeskVideo') as HTMLVideoElement | null;
  const track = document.getElementById('heroTimelineTrack') as HTMLElement | null;
  const progress = document.getElementById('heroTimelineProgress') as HTMLElement | null;
  const markEls = Array.from(document.querySelectorAll('.hero-mark')) as HTMLElement[];
  const segEls = Array.from(document.querySelectorAll('.hero-seg')) as HTMLElement[];

  if (heroVideo && track && progress && markEls.length) {
    const times = markEls.map((el) => parseFloat(el.dataset.t || '0'));

    function layoutMarks() {
      const dur = heroVideo!.duration;
      if (!dur || !isFinite(dur)) return;
      markEls.forEach((el, i) => {
        el.style.left = (times[i] / dur) * 100 + '%';
      });
      segEls.forEach((el, i) => {
        const start = times[i];
        const end = i < times.length - 1 ? times[i + 1] : dur;
        el.style.left = (start / dur) * 100 + '%';
        el.style.width = ((end - start) / dur) * 100 + '%';
      });
    }
    if (heroVideo.readyState >= 1) layoutMarks();
    heroVideo.addEventListener('loadedmetadata', layoutMarks);

    function seekFromClientX(clientX: number) {
      const rect = track!.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      const dur = heroVideo!.duration;
      if (dur && isFinite(dur)) heroVideo!.currentTime = ratio * dur;
    }
    track.addEventListener('click', (e) => seekFromClientX((e as MouseEvent).clientX));

    segEls.forEach((el, i) => {
      el.addEventListener('click', () => {
        heroVideo!.currentTime = times[i];
      });
    });

    heroVideo.addEventListener('timeupdate', () => {
      const dur = heroVideo!.duration;
      const t = heroVideo!.currentTime;
      if (dur && isFinite(dur)) progress!.style.width = (t / dur) * 100 + '%';
      let activeIdx = 0;
      for (let i = 0; i < times.length; i++) {
        if (t >= times[i]) activeIdx = i;
      }
      markEls.forEach((el, i) => el.classList.toggle('active', i === activeIdx));
    });
  }
</script>
